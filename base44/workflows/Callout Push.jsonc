{
  "name": "Callout Push",
  "description": "Pushes a phone notification to app users when someone posts a callout about a token",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Post",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.token_symbol != null }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "callout_push",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "push_callout": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pushNotify",
            "args": {
              "title": "\ud83d\udce3 New callout on PumpLaunch",
              "content": "${ .trigger.data.token_symbol } is getting called \u2014 tap to see the feed",
              "action_label": "Open",
              "action_url": "https://pumplaunch.app"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Push the callout alert",
            "description": "Phone notification to app users"
          }
        }
      }
    ]
  }
}