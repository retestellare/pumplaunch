{
  "name": "LaunchAttempt",
  "type": "object",
  "properties": {
    "wallet_address": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "supply": {
      "type": "number"
    },
    "custom_domain": {
      "type": "string"
    },
    "liquidity": {
      "type": "number"
    },
    "auto_pool": {
      "type": "boolean"
    },
    "initial_liquidity": {
      "type": "number"
    },
    "launch_model": {
      "type": "string",
      "enum": [
        "curve",
        "auto_pool",
        "locked"
      ],
      "default": "curve"
    },
    "locked_quote": {
      "type": "string",
      "enum": [
        "xlm",
        "usdc"
      ]
    },
    "locked_deposit": {
      "type": "number"
    },
    "vault_tokens": {
      "type": "number"
    },
    "creator_allocation": {
      "type": "number"
    },
    "tokens_per_quote": {
      "type": "number"
    },
    "vault_public_key": {
      "type": "string"
    },
    "curve": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "token_id": {
      "type": "string"
    },
    "issuer_public_key": {
      "type": "string"
    },
    "reused_asset": {
      "type": "boolean"
    },
    "pool_type": {
      "type": "string",
      "enum": [
        "xlm",
        "usdc",
        "dual",
        "split"
      ],
      "default": "xlm"
    },
    "usdc_before_swap": {
      "type": "number"
    },
    "step": {
      "type": "string"
    },
    "step_label": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "error_code": {
      "type": "string"
    }
  },
  "required": [
    "wallet_address",
    "symbol",
    "step"
  ]
}