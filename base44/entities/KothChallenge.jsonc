{
  "name": "KothChallenge",
  "type": "object",
  "properties": {
    "wallet_address": {
      "type": "string"
    },
    "token_id": {
      "type": "string"
    },
    "token_symbol": {
      "type": "string"
    },
    "token_name": {
      "type": "string"
    },
    "token_image": {
      "type": "string"
    },
    "amount_xlm": {
      "type": "number",
      "default": 0
    },
    "memo": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "won",
        "outbid",
        "invalid"
      ],
      "default": "pending"
    },
    "tx_hash": {
      "type": "string"
    },
    "error": {
      "type": "string"
    }
  },
  "required": [
    "wallet_address",
    "token_id",
    "amount_xlm",
    "memo"
  ]
}