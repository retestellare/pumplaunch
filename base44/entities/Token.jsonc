{
  "name": "Token",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "creator": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "asset_code": {
      "type": "string"
    },
    "home_domain": {
      "type": "string"
    },
    "custom_domain": {
      "type": "string"
    },
    "supply": {
      "type": "number",
      "default": 1000000000
    },
    "liquidity_percent": {
      "type": "number",
      "default": 100
    },
    "curve": {
      "type": "string",
      "enum": [
        "slow",
        "medium",
        "fast",
        "hyper"
      ],
      "default": "slow"
    },
    "toml_content": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "default": 1e-06
    },
    "market_cap": {
      "type": "number"
    },
    "holders": {
      "type": "number",
      "default": 1
    },
    "volume_24h": {
      "type": "number",
      "default": 0
    },
    "change_24h": {
      "type": "number",
      "default": 0
    },
    "is_graduated": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "symbol"
  ]
}