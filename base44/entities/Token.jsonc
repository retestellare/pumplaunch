{
  "name": "Token",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "og_image_url": {
      "type": "string"
    },
    "creator": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "asset_code": {
      "type": "string"
    },
    "home_domain": {
      "type": "string"
    },
    "custom_domain": {
      "type": "string"
    },
    "supply": {
      "type": "number",
      "default": 1000000000
    },
    "liquidity_percent": {
      "type": "number",
      "default": 100
    },
    "is_auto_pool": {
      "type": "boolean",
      "default": false
    },
    "is_imported": {
      "type": "boolean",
      "default": false
    },
    "launch_model": {
      "type": "string",
      "enum": [
        "curve",
        "auto_pool",
        "locked"
      ],
      "default": "curve"
    },
    "locked_quote": {
      "type": "string",
      "enum": [
        "xlm",
        "usdc"
      ]
    },
    "locked_liquidity": {
      "type": "number"
    },
    "creator_allocation": {
      "type": "number"
    },
    "vault_tokens": {
      "type": "number"
    },
    "tokens_per_quote": {
      "type": "number"
    },
    "lock_account": {
      "type": "string"
    },
    "lock_mode": {
      "type": "string",
      "enum": [
        "permanent",
        "timelock"
      ],
      "enumColors": [
        "gray",
        "blue"
      ],
      "default": "permanent"
    },
    "timelock_unlock_at": {
      "type": "number"
    },
    "timelock_shares": {
      "type": "number"
    },
    "timelock_percent": {
      "type": "number"
    },
    "timelock_tx": {
      "type": "string"
    },
    "timelock_contract": {
      "type": "string"
    },
    "pools": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "xlm",
          "usdc"
        ]
      },
      "default": [
        "xlm"
      ]
    },
    "curve": {
      "type": "string",
      "enum": [
        "slow",
        "medium",
        "fast",
        "hyper"
      ],
      "default": "slow"
    },
    "toml_content": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "default": 1e-06
    },
    "market_cap": {
      "type": "number"
    },
    "holders": {
      "type": "number",
      "default": 1
    },
    "volume_24h": {
      "type": "number",
      "default": 0
    },
    "change_24h": {
      "type": "number",
      "default": 0
    },
    "is_graduated": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "symbol"
  ]
}