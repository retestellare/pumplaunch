{
  "name": "FreeLaunch",
  "type": "object",
  "properties": {
    "wallet_address": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "granted",
        "failed"
      ],
      "default": "granted"
    },
    "amount_xlm": {
      "type": "number",
      "default": 0
    },
    "tx_hash": {
      "type": "string"
    },
    "error": {
      "type": "string"
    }
  },
  "required": [
    "wallet_address"
  ]
}