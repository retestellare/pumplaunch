{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "push_notifications": {
      "type": "boolean",
      "description": "Whether this user receives push notifications on their phone",
      "default": true
    }
  },
  "required": [
    "role"
  ]
}